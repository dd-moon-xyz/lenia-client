# Client settings. Copy to .env; environment variables override this file.
LENIA_URL=ws://192.168.0.15:9876/ws
# Optional JSON simulation start configuration; omit to fetch the server preset.
# LENIA_CONFIG=/absolute/path/config.json
LENIA_WINDOWED=false
LENIA_MOTION_DEVICE=/dev/i2c-1
LENIA_MOTION_THRESHOLD=0.12
# Person box height / image height. Lower reacts farther away; must be 0 < value < 1.
LENIA_PERSON_PROXIMITY=0.5
